# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/bisum-conference

# Flutterwave Configuration
FLUTTERWAVE_PUBLIC_KEY=your_flutterwave_public_key_here
FLUTTERWAVE_SECRET=your_flutterwave_secret_key_here
FLUTTERWAVE_SECRET_HASH=your_flutterwave_secret_hash_here
FLUTTERWAVE_REDIRECT_URL=http://localhost:3000/payment/callback

# Email Configuration (Gmail)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here

# JWT Configuration (for future admin authentication)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=24h

# Production URLs (update these for production)
PRODUCTION_URL=https://bisum.hgbcglobal.org
CLIENT_URL=http://localhost:3000
