# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Flutterwave Configuration (for payment processing)
VITE_FLUTTERWAVE_PUBLIC_KEY=your_flutterwave_public_key_here

# Application Configuration
VITE_APP_NAME=BISUM Conference 2025
VITE_APP_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000/api

# Email Configuration (optional - for email notifications)
VITE_SUPPORT_EMAIL=support@bisum.org
VITE_ADMIN_EMAIL=admin@bisum.org

# Conference Details
VITE_CONFERENCE_NAME=BISUM Conference 2025
VITE_CONFERENCE_DATE=2024-06-15
VITE_CONFERENCE_VENUE=Higher Ground Baptist Curch, Ogbomoso, Nigeria

# Registration Pricing (in Naira)
VITE_STUDENT_PRICE=1000
VITE_PROFESSIONAL_PRICE=2000

# Feature Flags
VITE_ENABLE_REAL_TIME_UPDATES=true
VITE_ENABLE_SESSION_REGISTRATION=true
VITE_ENABLE_PAYMENT_INTEGRATION=true

# Development/Debug Settings
VITE_DEBUG_MODE=false
VITE_LOG_LEVEL=info
